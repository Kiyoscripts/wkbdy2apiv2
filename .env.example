WKB2API_API_KEY=change-me-at-least-16-chars
HOST=127.0.0.1
PORT=7891
LOG_LEVEL=info

# Optional explicit aliases for /v1/messages. Responses report the actual upstream model.
WKB2API_MODEL_ALIASES={}

# Upstream (defaults verified against the WorkBuddy chat protocol)
WKB2API_UPSTREAM_URL=https://www.workbuddy.ai/v2/chat/completions
WKB2API_UPSTREAM_UA=WorkBuddy/2.137.1
WKB2API_FIRST_BYTE_TIMEOUT_MS=60000
WKB2API_IDLE_TIMEOUT_MS=300000

# ---- Account-store encryption key -------------------------------------------
# The key that encrypts the account blob. Two ways to supply it; the base64
# value wins when both are set.
#
# Prefer the base64 variable on any host without a persistent disk (Render and
# similar): there is nothing to mount and the key survives restarts, so the
# accounts in the database stay readable.
#   Generate with:  openssl rand -base64 32
# WKB2API_ACCOUNT_STORE_KEY_B64=
#
# Or mount a file containing 32 raw bytes or their base64 encoding.
WKB2API_ACCOUNT_STORE_KEY_FILE=./account-store.key
WKB2API_ACCOUNT_STORE_PATH=data/accounts.enc

# Refuse to start when no key is available (the default), rather than silently
# generating a throwaway key that makes stored accounts undecryptable after a
# restart. Only set true for a throwaway local run.
WKB2API_ALLOW_EPHEMERAL_STORE=false

# The key used to create the first admin account when the registry is empty.
# A well-known default so a fresh install is never locked out; change it.
WKB2API_BOOTSTRAP_ADMIN_KEY=wkb_admin_default_change_me
WKB2API_API_KEYS_PATH=data/api-keys.json

# ---- Persistence backend ---------------------------------------------------
# file     = encrypted account blob + JSONL telemetry on local disk.
# postgres = both in a database. Required on hosts that recycle the filesystem
#            between deploys (Render and similar) — the file backend loses the
#            account pool and the whole request history on every restart.
#
# The account blob stays AES-256-GCM encrypted before it is written, so the
# database only ever holds ciphertext; the key never leaves the process.
WKB2API_STORAGE_BACKEND=file
# WKB2API_DATABASE_URL=postgres://user:password@host:5432/wkbdy2api
# TLS defaults to on for any non-local host. Set explicitly only to override.
# WKB2API_DATABASE_SSL=true
WKB2API_DATABASE_POOL_SIZE=5

# Optional local WorkBuddy credential file used only by the admin import endpoint.
# WKB2API_CREDENTIALS_PATH=

# JSONL trace of raw upstream/downstream tool-call frames. Set to an empty
# string to disable. When a client reports broken tool arguments, this file
# shows the exact deltas upstream sent, which distinguishes a parser mismatch
# from streaming truncation from a bad fallback.
WKB2API_TOOL_TRACE_PATH=data/tool-calls.jsonl
